# Variáveis de ambiente do backend — Plataforma Financeira Synapse
#
# Este arquivo é COMMITADO e não contém valores (Princípio VII da constituição).
# Para rodar local: Copy-Item .env.exemplo .env  e preencher.
# O .env está no .gitignore e nunca deve ser commitado.
#
# Referência: specs/001-erp-financeiro-synapse/quickstart.md §4

# Conexão com o Postgres do Supabase (Settings → Database)
DATABASE_URL=

# Endereço do projeto Supabase (Settings → API)
SUPABASE_URL=

# Acesso administrativo do backend ao Storage e aos usuários (Settings → API).
# SEGREDO: ignora todas as políticas de segurança do banco. Nunca no frontend,
# nunca em arquivo commitado, nunca em mensagem de chat.
SUPABASE_SERVICE_ROLE_KEY=

# Validação do token de login. Conferir no painel qual modo o projeto usa
# (research.md D-03). Valores: hs256 | jwks
SUPABASE_JWT_MODO=
# Preenchido só quando SUPABASE_JWT_MODO=hs256
SUPABASE_JWT_SEGREDO=

# Protege POST /api/rotinas/* — o cron chama sem usuário logado
SEGREDO_ROTINA=

# Sobrepõe configuracoes.cambio_fonte_primaria em desenvolvimento (RN-12)
CAMBIO_FONTE_PRIMARIA=

# local | producao
AMBIENTE=local
